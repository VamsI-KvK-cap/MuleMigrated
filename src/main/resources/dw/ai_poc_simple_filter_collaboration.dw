%dw 2.0
output application/json

fun ai_poc_simple_filter_collaboration(message_string) {
  var input_map = {}
  var output_map = {}
  var skip = false
  try {
    input_map = parse_hl7_message(message_string)
    output_map = {}
    skip = if (input_map.MSA and input_map.MSA.text_message contains 'ZZZ') true else false
    if (skip) do {
      output_map = {}
    } else do {
      output_map.MSH = input_map.MSH
      output_map.MSA = input_map.MSA
    }
    var output_string = write(output_map, 'application/hl7')
    log(skip)
    return skip ? '' : output_string
  } catch (error) {
    return ''
  } finally {
    input_map = {}
    output_map = {}
  }
}