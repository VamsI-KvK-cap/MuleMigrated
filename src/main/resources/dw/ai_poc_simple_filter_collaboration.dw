%dw 2.0
output application/json

fun parse_hl7_message(message_string) =
    {
        MSH: message_string match /(?<=MSH\|).*?(?=\r)/,
        MSA: message_string match /(?<=MSA\|).*?(?=\r)/ map ((segment) -> { text_message: segment })
    }

fun ai_poc_simple_filter_collaboration(message_string) {
    var input_map = {}
    var output_map = {}
    var skip = false
    try {
        input_map = parse_hl7_message(message_string)
        output_map = {}
        if (input_map.MSA) {
            if (input_map.MSA.size() > 1) {
                output_map.multiple_msa_segments = true
            }
            var msa_text_message = input_map.MSA[0].text_message
            if (msa_text_message contains 'ZZZ') {
                skip = true
            } else {
                skip = false
            }
        } else {
            skip = false
        }
        if (skip) {
            output_map = {}
        } else {
            output_map.MSH = input_map.MSH
            output_map.MSA = input_map.MSA
        }
        var output_string = write(output_map, 'application/json')
        input_map = {}
        output_map = {}
        return output_string
    } catch (error) {
        input_map = {}
        output_map = {}
        return ''
    }
}