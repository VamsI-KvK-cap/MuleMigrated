%dw 2.0
output application/json

fun parse_hl7_message(str_message) {
    var segments = str_message splitBy '\r'
    var parsed_message = {}

    var segment_mapping = {
        'MSH': 'MSH-struct',
        'MSA': 'MSA-struct',
        'ERR': 'ERR-struct'
    }

    for (segment in segments) {
        var segment_parts = segment splitBy '|'
        var segment_id = segment_parts[0]
        var segment_structure = segment_mapping[segment_id]

        var segment_object = {}

        if (segment_structure == 'MSH-struct') {
            segment_object['segment_ID'] = segment_parts[0]
            segment_object['encoding_characters'] = segment_parts[1]
            segment_object['sending_application'] = parse_hd(segment_parts[2])
            segment_object['sending_facility'] = parse_hd(segment_parts[3])
            segment_object['receiving_application'] = parse_hd(segment_parts[4])
            segment_object['receiving_facility'] = parse_hd(segment_parts[5])
            segment_object['datetime_of_message'] = segment_parts[6]
            segment_object['security'] = segment_parts[7]
            segment_object['message_type'] = segment_parts[8]
            segment_object['message_control_ID'] = segment_parts[9]
            segment_object['processing_id'] = segment_parts[10]
            segment_object['version_ID'] = segment_parts[11]
        } else if (segment_structure == 'MSA-struct') {
            segment_object['segment_ID'] = segment_parts[0]
            segment_object['acknowledgment_code'] = segment_parts[1]
            segment_object['message_control_ID'] = segment_parts[2]
            segment_object['text_message'] = segment_parts[3]
        } else if (segment_structure == 'ERR-struct') {
            segment_object['segment_ID'] = segment_parts[0]
            segment_object['error_code'] = segment_parts[1]
            segment_object['error_severity'] = segment_parts[2]
            segment_object['error_location'] = segment_parts[3]
            segment_object['error_description'] = segment_parts[4]
        }

        parsed_message[segment_id] = (parsed_message[segment_id] default []) ++ [segment_object]
    }

    return parsed_message
}

fun parse_hd(field) {
    var hd_parts = field splitBy '^'
    return {
        'namespace_ID': hd_parts[0],
        'universal_ID': hd_parts[1],
        'universal_ID_type': hd_parts[2]
    }
}