package main.mule;

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:dw="http://www.mulesoft.org/schema/mule/documentation" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/documentation http://www.mulesoft.org/schema/mule/documentation/current/mule-documentation.xsd">
  <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
    <http:listener-connection host="0.0.0.0" port="8081"/>
  </http:listener-config>
  <flow name="AI_PoC_Simple_FilterCollaboration">
    <http:listener doc:name="Listener" config-ref="HTTP_Listener_config" path="/processHL7"/>
    <dw:transform-message doc:name="Transform Message">
      <dw:set-payload><![CDATA[
        %dw 2.0
        output application/json
        var input_map = {}
        var output_map = {}
        var skip = false
        try {
          input_map = parse_hl7_message(payload)
          if (input_map contains 'MSA') {
            var msa_segment = input_map['MSA'][0]
            if (msa_segment['MSA-3-text_message'] contains 'ZZZ') {
              skip = true
            }
          }
          if (!skip) {
            output_map['MSH'] = input_map['MSH']
            output_map['MSA'] = input_map['MSA']
          }
        } catch (e) {
          return ""
        }
        var result = skip ? "" : write(output_map, 'application/json')
        output_map = {}
        input_map = {}
        return result
      ]]></dw:set-payload>
    </dw:transform-message>
    <logger message="Processed message: ++ [payload]" level="INFO" doc:name="Log Processed Message"/>
    <set-payload value="payload" doc:name="Set Payload"/>
  </flow>
</mule>