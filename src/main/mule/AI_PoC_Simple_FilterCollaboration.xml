<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:dw="http://www.mulesoft.org/schema/mule/data-weave" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/data-weave http://www.mulesoft.org/schema/mule/data-weave/current/mule-data-weave.xsd">
  <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config" doc:id="http_listener_config_id">
    <http:listener-connection/>
  </http:listener-config>
  <flow name="AI_PoC_Simple_FilterCollaboration" doc:id="flow_id">
    <http:listener doc:name="Listener" doc:id="listener_id" config-ref="HTTP_Listener_config" path="/processHL7"/>
    <logger message="Received message: #[payload]" level="INFO" doc:name="Log Received Message"/>
    <set-variable variableName="input_map" value="#[dw('ai_poc_simple_filter', payload)]" doc:name="Set Input Map"/>
    <set-variable variableName="output_map" value="#[]" doc:name="Initialize Output Map"/>
    <set-variable variableName="skip" value="false" doc:name="Initialize Skip Flag"/>
    <choice doc:name="Check MSA Segments">
      <when expression="#[input_map.MSA != null]">
        <logger message="MSA segments found" level="INFO" doc:name="Log MSA Found"/>
        <set-variable variableName="msa_message" value="#[input_map.MSA['MSA-3-text_message']]" doc:name="Get MSA Message"/>
        <logger message="MSA-3-text_message: #[msa_message]" level="INFO" doc:name="Log MSA Message"/>
        <choice doc:name="Check for ZZZ">
          <when expression="#[msa_message contains 'ZZZ']">
            <set-variable variableName="skip" value="true" doc:name="Set Skip Flag"/>
            <logger message="Message will be skipped" level="INFO" doc:name="Log Skip Message"/>
          </when>
          <otherwise>
            <logger message="Message will be processed" level="INFO" doc:name="Log Process Message"/>
          </otherwise>
        </choice>
      </when>
      <otherwise>
        <logger message="No MSA segments found" level="INFO" doc:name="Log No MSA Found"/>
      </otherwise>
    </choice>
    <choice doc:name="Process Based on Skip Flag">
      <when expression="#[skip == true]">
        <set-variable variableName="output_map" value="#[]" doc:name="Clear Output Map"/>
      </when>
      <otherwise>
        <set-variable variableName="output_map['MSH']" value="#[input_map.MSH]" doc:name="Copy MSH to Output Map"/>
        <set-variable variableName="output_map['MSA']" value="#[input_map.MSA]" doc:name="Copy MSA to Output Map"/>
      </otherwise>
    </choice>
    <set-variable variableName="processedMessage" value="#[output_map as String]" doc:name="Convert Output Map to String"/>
    <logger message="Processed message: #[processedMessage]" level="INFO" doc:name="Log Processed Message"/>
    <set-variable variableName="input_map" value="#[]" doc:name="Clear Input Map"/>
    <set-variable variableName="output_map" value="#[]" doc:name="Clear Output Map"/>
    <set-payload value="#[processedMessage]" doc:name="Set Payload"/>
    <error-handler>
      <on-error-continue enableNotifications="true" doc:name="Error Handler">
        <logger message="Error occurred: #[error.message]" level="ERROR" doc:name="Log Error"/>
        <set-payload value="#['']" doc:name="Return Empty String"/>
      </on-error-continue>
    </error-handler>
  </flow>
</mule>