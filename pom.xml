<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>hl7-mule-project</artifactId>
  <version>1.0.0</version>
  <packaging>mule</packaging>
  <properties>
    <mule.version>4.4.0</mule.version>
    <dw.version>2.4.0</dw.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-http-connector</artifactId>
      <version>${mule.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-hl7-module</artifactId>
      <version>${mule.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-json-module</artifactId>
      <version>${mule.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-dataweave-module</artifactId>
      <version>${dw.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.mule.tools</groupId>
        <artifactId>mule-maven-plugin</artifactId>
        <version>${mule.version}</version>
      </plugin>
    </plugins>
  </build>
  <properties>
    <hl7.validation>true</hl7.validation>
  </properties>
  <documentation>
    <developerGuide>Refer to the HL7 MuleSoft documentation for implementation details.</developerGuide>
    <examples>
      <mshExample>MSH|^~\&|SendingApp|SendingFac|ReceivingApp|ReceivingFac|202301011200||ACK^A01|123456|P|2.3.1</mshExample>
    </examples>
  </documentation>
</project>