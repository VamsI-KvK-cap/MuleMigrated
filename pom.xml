<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.example</groupId>
  <artifactId>hl7-message-processor</artifactId>
  <version>1.0.0</version>
  <packaging>mule</packaging>
  <properties>
    <mule.version>4.4.0</mule.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-http-connector</artifactId>
      <version>${mule.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-dataweave-module</artifactId>
      <version>${mule.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-hl7-module</artifactId>
      <version>${mule.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mule.runtime.module</groupId>
      <artifactId>mule-json-module</artifactId>
      <version>${mule.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.mule.tools</groupId>
        <artifactId>mule-maven-plugin</artifactId>
        <version>${mule.version}</version>
        <configuration>
          <muleVersion>${mule.version}</muleVersion>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>